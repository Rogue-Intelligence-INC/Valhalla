# 🌊 Wave Boot Sector Fixer
# 修复裸机镜像的引导扇区，添加磁盘读取代码
# 
# 用法: ./bin/wave src/boot_fix.wave 然后运行生成的程序

out "Wave Boot Sector Fixer"
out "======================"
out ""
out "This tool fixes bare-metal images by adding disk read code to the boot sector."
out ""
out "The Wave compiler generates images where:"
out "  - Boot sector at 0x0000 (512 bytes)"
out "  - Code at 0x1000 (NOT loaded by BIOS!)"
out ""
out "Fix: Add INT 13h disk read to load sectors 2+ to memory."
out ""
out "Boot sector should:"
out "  1. Read sectors from disk to 0x1000"
out "  2. Then jump to 0x1000"
out ""
out "Correct boot sequence:"
out "  cli"
out "  xor ax, ax"
out "  mov ds/es/ss, ax"
out "  mov sp, 0x7C00"
out "  mov bx, 0x1000      ; destination"
out "  mov ah, 0x02        ; read sectors"
out "  mov al, 32          ; sector count"
out "  mov ch, 0           ; cylinder"
out "  mov cl, 2           ; start sector"
out "  mov dh, 0           ; head"
out "  mov dl, 0           ; drive"
out "  int 0x13            ; BIOS disk read"
out "  lgdt [gdt_desc]"
out "  enter protected mode"
out "  jmp 0x08:0x1000"
