# 🌊 Wave 完整色彩演示
# 24-bit True Color + 渐变 + 透明

# ═══════════════════════════════════════════════════════
# RGB 直接控制
# ═══════════════════════════════════════════════════════

demo_rgb -> show {
    output -> "\x1b[38;2;255;100;50mRGB(255,100,50)\x1b[0m"
    output -> "\x1b[38;2;50;200;150mRGB(50,200,150)\x1b[0m"
    output -> "\x1b[38;2;200;50;255mRGB(200,50,255)\x1b[0m"
}

# ═══════════════════════════════════════════════════════
# 渐变文字
# ═══════════════════════════════════════════════════════

demo_gradient_text -> show {
    # 火焰渐变: WAVE
    output -> "\x1b[38;2;255;0;0mW\x1b[38;2;255;85;0mA\x1b[38;2;255;170;0mV\x1b[38;2;255;255;0mE\x1b[0m FIRE"
    
    # 海洋渐变: WAVE
    output -> "\x1b[38;2;0;0;139mW\x1b[38;2;0;85;180mA\x1b[38;2;0;170;220mV\x1b[38;2;0;255;255mE\x1b[0m OCEAN"
    
    # 霓虹渐变: WAVE
    output -> "\x1b[38;2;255;0;255mW\x1b[38;2;127;127;255mA\x1b[38;2;0;255;255mV\x1b[38;2;127;255;127mE\x1b[0m NEON"
    
    # 彩虹渐变: RAINBOW
    output -> "\x1b[38;2;255;0;0mR\x1b[38;2;255;127;0mA\x1b[38;2;255;255;0mI\x1b[38;2;0;255;0mN\x1b[38;2;0;0;255mB\x1b[38;2;75;0;130mO\x1b[38;2;148;0;211mW\x1b[0m"
}

# ═══════════════════════════════════════════════════════
# 渐变进度条
# ═══════════════════════════════════════════════════════

demo_gradient_progress -> show {
    # 红→黄→绿 渐变进度条
    output -> "[\x1b[38;2;255;0;0m█\x1b[38;2;255;51;0m█\x1b[38;2;255;102;0m█\x1b[38;2;255;153;0m█\x1b[38;2;255;204;0m█\x1b[38;2;255;255;0m█\x1b[38;2;204;255;0m█\x1b[38;2;153;255;0m█\x1b[38;2;102;255;0m█\x1b[38;2;51;255;0m█\x1b[38;2;0;255;0m█\x1b[0m░░░░░░░░░] 50%"
}

# ═══════════════════════════════════════════════════════
# 背景渐变
# ═══════════════════════════════════════════════════════

demo_bg_gradient -> show {
    # 背景色渐变
    output -> "\x1b[48;2;30;0;50m \x1b[48;2;50;0;80m \x1b[48;2;70;0;110m \x1b[48;2;90;0;140m \x1b[48;2;110;0;170m \x1b[48;2;130;0;200m \x1b[0m 紫色渐变背景"
    
    output -> "\x1b[48;2;0;30;50m \x1b[48;2;0;60;80m \x1b[48;2;0;90;110m \x1b[48;2;0;120;140m \x1b[48;2;0;150;170m \x1b[48;2;0;180;200m \x1b[0m 青色渐变背景"
}

# ═══════════════════════════════════════════════════════
# 透明度模拟
# ═══════════════════════════════════════════════════════

demo_alpha -> show {
    # 模拟 100% 不透明
    output -> "\x1b[48;2;255;0;0m████████\x1b[0m 100% 不透明"
    
    # 模拟 75% 透明 (与黑色混合)
    output -> "\x1b[48;2;191;0;0m████████\x1b[0m 75%"
    
    # 模拟 50% 透明
    output -> "\x1b[48;2;127;0;0m████████\x1b[0m 50%"
    
    # 模拟 25% 透明
    output -> "\x1b[48;2;63;0;0m████████\x1b[0m 25%"
}

# ═══════════════════════════════════════════════════════
# 渐变面板
# ═══════════════════════════════════════════════════════

demo_gradient_panel -> show {
    # 顶部渐变边框
    output -> "\x1b[38;2;255;100;100m╭\x1b[38;2;255;150;100m─\x1b[38;2;255;200;100m─\x1b[38;2;255;255;100m─\x1b[38;2;200;255;100m─\x1b[38;2;150;255;100m─\x1b[38;2;100;255;100m╮\x1b[0m"
    output -> "\x1b[38;2;255;100;150m│\x1b[0m     \x1b[38;2;100;255;150m│\x1b[0m"
    output -> "\x1b[38;2;255;100;200m│\x1b[0m     \x1b[38;2;100;255;200m│\x1b[0m"
    output -> "\x1b[38;2;255;100;255m╰\x1b[38;2;200;100;255m─\x1b[38;2;150;100;255m─\x1b[38;2;100;100;255m─\x1b[38;2;100;150;255m─\x1b[38;2;100;200;255m─\x1b[38;2;100;255;255m╯\x1b[0m"
}

# ═══════════════════════════════════════════════════════
# 色彩范围展示
# ═══════════════════════════════════════════════════════

demo_spectrum -> show {
    # 色相环 (简化)
    output -> "\x1b[38;2;255;0;0m█\x1b[38;2;255;127;0m█\x1b[38;2;255;255;0m█\x1b[38;2;127;255;0m█\x1b[38;2;0;255;0m█\x1b[38;2;0;255;127m█\x1b[38;2;0;255;255m█\x1b[38;2;0;127;255m█\x1b[38;2;0;0;255m█\x1b[38;2;127;0;255m█\x1b[38;2;255;0;255m█\x1b[38;2;255;0;127m█\x1b[0m 色相环"
    
    # 灰度
    output -> "\x1b[38;2;0;0;0m█\x1b[38;2;32;32;32m█\x1b[38;2;64;64;64m█\x1b[38;2;96;96;96m█\x1b[38;2;128;128;128m█\x1b[38;2;160;160;160m█\x1b[38;2;192;192;192m█\x1b[38;2;224;224;224m█\x1b[38;2;255;255;255m█\x1b[0m 灰度"
}

# ═══════════════════════════════════════════════════════
# 运行演示
# ═══════════════════════════════════════════════════════

main -> run {
    output -> ""
    output -> "\x1b[1;38;2;100;200;255m╔════════════════════════════════════════╗\x1b[0m"
    output -> "\x1b[1;38;2;100;200;255m║\x1b[0m   \x1b[1m🌊 Wave 完整色彩系统演示\x1b[0m           \x1b[1;38;2;100;200;255m║\x1b[0m"
    output -> "\x1b[1;38;2;100;200;255m║\x1b[0m   24-bit True Color · 16M+ 颜色      \x1b[1;38;2;100;200;255m║\x1b[0m"
    output -> "\x1b[1;38;2;100;200;255m╚════════════════════════════════════════╝\x1b[0m"
    output -> ""
    
    output -> "\x1b[1;33m=== RGB 直接控制 ===\x1b[0m"
    demo_rgb -> execute
    output -> ""
    
    output -> "\x1b[1;33m=== 渐变文字 ===\x1b[0m"
    demo_gradient_text -> execute
    output -> ""
    
    output -> "\x1b[1;33m=== 渐变进度条 ===\x1b[0m"
    demo_gradient_progress -> execute
    output -> ""
    
    output -> "\x1b[1;33m=== 背景渐变 ===\x1b[0m"
    demo_bg_gradient -> execute
    output -> ""
    
    output -> "\x1b[1;33m=== 透明度模拟 ===\x1b[0m"
    demo_alpha -> execute
    output -> ""
    
    output -> "\x1b[1;33m=== 渐变面板 ===\x1b[0m"
    demo_gradient_panel -> execute
    output -> ""
    
    output -> "\x1b[1;33m=== 色彩范围 ===\x1b[0m"
    demo_spectrum -> execute
    output -> ""
}
