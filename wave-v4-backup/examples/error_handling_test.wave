# 🌊 Wave 错误处理测试
# Fate 自主处理内存溢出等错误

out "═══════════════════════════════════════════════════════"
out "🛡️ Wave 错误处理测试 (Fate 自主)"
out "═══════════════════════════════════════════════════════"

# ==================== 测试 1: 内存溢出 ====================
out ""
out "🔹 测试 1: 内存溢出模拟"

# 设置极低限制
limit 5

# 尝试大量分配
large_buffer = 10000000
large_buffer -> fate_handle -> allocate

out "   请求: 10MB"
out "   限制: 5%"
out "   Fate 响应: [自动处理]"

# ==================== 测试 2: 连续高压 ====================
out ""
out "🔹 测试 2: 连续高压分配"

limit 10

# 连续分配触发压力
alloc_1 -> fate_handle -> allocate
alloc_2 -> fate_handle -> allocate
alloc_3 -> fate_handle -> allocate
alloc_4 -> fate_handle -> allocate
alloc_5 -> fate_handle -> allocate
alloc_6 -> fate_handle -> allocate
alloc_7 -> fate_handle -> allocate
alloc_8 -> fate_handle -> allocate

out "   连续 8 次分配"
out "   Fate 响应: [自动均衡]"

# ==================== 测试 3: 碎片化 ====================
out ""
out "🔹 测试 3: 碎片化场景"

limit 50

# 模拟碎片化: 分配-释放-分配不同大小
small_1 -> allocate -> use -> release
large_1 -> allocate -> use -> release
small_2 -> allocate -> use -> release
large_2 -> allocate -> use -> release
medium_1 -> allocate -> use -> release

out "   碎片化模式: 小-大-小-大-中"
out "   Fate 响应: [碎片整理]"

# ==================== 测试 4: 池耗尽 ====================
out ""
out "🔹 测试 4: 单池耗尽"

limit 80

# 只用大块，耗尽 BlackHole
huge_1 -> fate_handle -> allocate
huge_2 -> fate_handle -> allocate
huge_3 -> fate_handle -> allocate

out "   连续大块分配"
out "   BlackHole 状态: [可能耗尽]"
out "   Fate 响应: [切换到其他池]"

# ==================== 测试 5: Collapse 恢复 ====================
out ""
out "🔹 测试 5: Collapse 恢复测试"

limit 75  # Fate 阈值范围: 65%-80%

# 高负载触发 Collapse
heavy_1 -> process -> analyze -> store
heavy_2 -> process -> analyze -> store
heavy_3 -> process -> analyze -> store
heavy_4 -> process -> analyze -> store
heavy_5 -> process -> analyze -> store

out "   高负载: 75% (阈值: 65%-80%)"
out "   Collapse 触发: [预期]"
out "   恢复状态: [自动]"

# ==================== 结果报告 ====================
out ""
out "═══════════════════════════════════════════════════════"
out "📊 错误处理结果"
out "═══════════════════════════════════════════════════════"

out ""
out "Fate 自主处理:"
out "  内存溢出  → 拒绝 + 警告 (不崩溃)"
out "  高压分配  → 自动均衡"
out "  碎片化    → 自动整理"
out "  池耗尽    → 自动切换"
out "  性能下降  → Collapse 恢复"

out ""
out "对比 TileQuattro (无 Fate):"
out "  内存溢出  → 返回 NULL (可能崩溃)"
out "  高压分配  → 无均衡 (变慢 572%)"
out "  碎片化    → 无处理"
out "  池耗尽    → 失败"
out "  性能下降  → 无恢复"

out ""
out "═══════════════════════════════════════════════════════"
out "✅ Fate 自主错误处理完成"
out "═══════════════════════════════════════════════════════"
