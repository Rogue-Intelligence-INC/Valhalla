# Val-OS Keyboard Driver
# Wave v5 - PS/2 Keyboard with interrupt

# Keyboard ports
keyboard_data -> 0x60
keyboard_status -> 0x64

# Key buffer
key_buffer -> fate_alloc
key_buffer_head -> 0
key_buffer_tail -> 0

# Scancode to ASCII mapping
scancode_map -> {
    0x1E: "a", 0x30: "b", 0x2E: "c", 0x20: "d", 0x12: "e",
    0x21: "f", 0x22: "g", 0x23: "h", 0x17: "i", 0x24: "j",
    0x25: "k", 0x26: "l", 0x32: "m", 0x31: "n", 0x18: "o",
    0x19: "p", 0x10: "q", 0x13: "r", 0x1F: "s", 0x14: "t",
    0x16: "u", 0x2F: "v", 0x11: "w", 0x2D: "x", 0x15: "y",
    0x2C: "z",
    0x02: "1", 0x03: "2", 0x04: "3", 0x05: "4", 0x06: "5",
    0x07: "6", 0x08: "7", 0x09: "8", 0x0A: "9", 0x0B: "0",
    0x1C: "\n", 0x39: " ", 0x0E: "\b",
    0x01: "ESC", 0x3B: "F1", 0x3C: "F2", 0x3D: "F3"
}

# Keyboard interrupt handler (IRQ1)
keyboard_handler -> function() {
    # Read scancode from port 0x60
    scancode -> in(keyboard_data)
    
    # Check if key press (not release)
    when scancode < 0x80 {
        # Convert to ASCII
        key -> scancode_map[scancode]
        
        # Add to buffer
        key_buffer[key_buffer_tail] -> key
        key_buffer_tail -> (key_buffer_tail + 1) % 256
    }
    
    # Send EOI
    out(0x20, 0x20)
}

# Read key (blocking)
read_key -> function() {
    # Wait for key
    fate_monitor -> fate_detect_marginal
    
    when key_buffer_head != key_buffer_tail {
        key -> key_buffer[key_buffer_head]
        key_buffer_head -> (key_buffer_head + 1) % 256
        key -> return
    }
}

# Check if key available
key_available -> function() {
    result -> key_buffer_head != key_buffer_tail
    result -> return
}

# Read line (with echo)
read_line -> function() {
    line -> ""
    loop {
        key -> read_key -> call
        when key == "\n" {
            line -> return
        }
        when key == "\b" {
            # Backspace
            line -> line[0..length(line)-1]
        }
        otherwise {
            line -> line + key
        }
    }
}

# Init keyboard
keyboard_init -> function() {
    # Install IRQ1 handler
    "keyboard" -> fate_alloc
    out "Keyboard initialized"
}
