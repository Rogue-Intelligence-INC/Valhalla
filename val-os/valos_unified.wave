# Val-OS v5.0 Unified Output
# Wave v5 - out 即是 CLI 也是 GUI

out "Val-OS v5.0"
out "═══════════════════════════"
out ""

# ═══════════════════════════════════════════════════════
# 这些 out 在不同模式下有不同渲染：
#
# 文本模式：打印文字
# 图形模式：渲染为 GUI 组件
# ═══════════════════════════════════════════════════════

# 标题 → 图形模式下变成标题栏
out "System Status"

# 状态信息 → 图形模式下变成面板
out "Fate Engine: Active"
out "Memory: Quattro Ready"
out "Display: Auto-detected"

out ""

# 分隔线 → 图形模式下变成真正的线
out "───────────────────────────"

out ""

# 按钮文字 → 图形模式下变成可点击按钮
out "[Files]"
out "[Terminal]"
out "[Browser]"
out "[Settings]"

out ""

# 复选框 → 图形模式下变成真正的复选框
out "[x] Enable Fate Collapse"
out "[ ] Debug Mode"
out "[x] Auto-save"

out ""
out "───────────────────────────"
out ""

# 输入提示 → 图形模式下变成输入框
out "> Enter command: _"

# ═══════════════════════════════════════════════════════
# Fate 决定如何渲染每个 out
# ═══════════════════════════════════════════════════════

# 文本模式输出：
#   Val-OS v5.0
#   ═══════════════════════════
#   
#   System Status
#   Fate Engine: Active
#   Memory: Quattro Ready
#   Display: Auto-detected
#   
#   ───────────────────────────
#   
#   [Files]
#   [Terminal]
#   [Browser]
#   [Settings]
#   
#   [x] Enable Fate Collapse
#   [ ] Debug Mode
#   [x] Auto-save
#   
#   ───────────────────────────
#   
#   > Enter command: _

# 图形模式输出：
#   ┌─────────────────────────────────┐
#   │ Val-OS v5.0                     │ ← 标题栏（渐变）
#   ├─────────────────────────────────┤
#   │ ┌─ System Status ─────────────┐ │
#   │ │ Fate Engine: Active         │ │ ← 面板
#   │ │ Memory: Quattro Ready       │ │
#   │ │ Display: Auto-detected      │ │
#   │ └─────────────────────────────┘ │
#   │                                 │
#   │ ┌──────┐ ┌──────┐ ┌──────┐    │
#   │ │Files │ │Term  │ │Browse│    │ ← 按钮
#   │ └──────┘ └──────┘ └──────┘    │
#   │                                 │
#   │ ☑ Enable Fate Collapse         │ ← 复选框
#   │ ☐ Debug Mode                   │
#   │ ☑ Auto-save                    │
#   │                                 │
#   │ ┌─────────────────────────────┐│
#   │ │ > _                         ││ ← 输入框
#   │ └─────────────────────────────┘│
#   └─────────────────────────────────┘

# ═══════════════════════════════════════════════════════
# Wave 的力量：同一代码，Fate 自适应渲染
# ═══════════════════════════════════════════════════════

# 不需要写两套代码（CLI + GUI）
# Wave 的 out 表达意图，Fate 决定渲染方式
# 这就是 Wave 的 "半CLI半GUI" 真正含义
