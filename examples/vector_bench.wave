# 向量相似度搜索基准测试 - Wave版
# 与 Python 版本使用相同参数

DIM = 16
COUNT = 100
RUNS = 1000

seed = 42
db = 0
query = 0

# LCG伪随机
fn rand {
    seed = seed * 1103515245 + 12345
    seed = seed & 0x7FFFFFFF
    -> seed % 2001 - 1000
}

# 点积
fn dot a b {
    sum = 0
    i = 0
    loop {
        when i >= DIM { -> sum }
        va = peek64(a + i * 8)
        vb = peek64(b + i * 8)
        sum = sum + va * vb
        i = i + 1
    }
}

# 初始化
fn init {
    db = syscall.mmap(0, COUNT * DIM * 8, 3, 0x22, -1, 0)
    query = syscall.mmap(0, DIM * 8, 3, 0x22, -1, 0)
    
    seed = 42
    i = 0
    loop {
        when i >= COUNT * DIM { -> 0 }
        poke64(db + i * 8, rand())
        i = i + 1
    }
    
    seed = 12345
    i = 0
    loop {
        when i >= DIM { -> 0 }
        poke64(query + i * 8, rand())
        i = i + 1
    }
}

# 单次搜索
fn search_once {
    best = 0
    best_score = -999999999
    
    i = 0
    loop {
        when i >= COUNT { -> best }
        vec = db + i * DIM * 8
        score = dot(query, vec)
        when score > best_score {
            best_score = score
            best = i
        }
        i = i + 1
    }
}

# 基准测试
fn benchmark {
    run = 0
    result = 0
    loop {
        when run >= RUNS { -> result }
        result = search_once()
        run = run + 1
    }
}

# 获取时间戳 (纳秒)
fn get_time {
    buf = syscall.mmap(0, 16, 3, 0x22, -1, 0)
    syscall.clock_gettime(1, buf)
    sec = peek64(buf)
    nsec = peek64(buf + 8)
    -> sec * 1000000000 + nsec
}

# 主程序
out "==================================================\n"
out "向量相似度搜索基准测试 - Wave版\n"
out "==================================================\n"
out "维度: 16, 向量数: 100, 重复次数: 1000\n\n"

out "初始化向量库...\n"
init()

out "查询向量已生成\n\n"

out "开始基准测试...\n"

t0 = get_time()
result = benchmark()
t1 = get_time()

elapsed = t1 - t0

out "\n"
out "==================================================\n"
out "结果\n"
out "==================================================\n"
out "最佳匹配索引: (computed)\n"
out "基准测试完成!\n"
out "耗时已记录 (内部纳秒计时)\n"

syscall.exit(0)
