# 验证随机数生成

seed = 42

fn rand {
    seed = seed * 1103515245 + 12345
    seed = seed & 2147483647
    -> seed % 201 - 100
}

out "Testing LCG random (seed=42):\n"

# 生成前10个随机数并验证
r0 = rand()
r1 = rand()
r2 = rand()
r3 = rand()
r4 = rand()

# 验证第一个随机数
# seed = 42 * 1103515245 + 12345 = 46347640635
# & 2147483647 = 46347640635 & 0x7FFFFFFF = 1761150587
# % 201 - 100 = 87 - 100 = -13
out "  r0 should be -13: "
when r0 == 0 - 13 { out "PASS\n" }
when r0 != 0 - 13 { out "FAIL\n" }

# 检查符号
out "  r0 < 0: "
when r0 < 0 { out "yes (correct)\n" }
when r0 >= 0 { out "no (wrong)\n" }

syscall.exit(0)
