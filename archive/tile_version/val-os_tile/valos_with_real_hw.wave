"i9-14900KF" -> analyze -> store
out "   CPU Driver: intel_fate_optimized"

"ddr5_125gb" -> analyze -> store
out "   Memory Driver: ddr5_fate_adaptive"

"nvidia_gpu" -> analyze -> store
