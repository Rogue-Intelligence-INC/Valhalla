# === 中断处理 ===
out "🔔 Setting up Interrupt Handlers:"

intent handle_timer_interrupt {
    out "   [IRQ 0] Timer tick → Scheduler"
}

intent handle_keyboard_interrupt {
    out "   [IRQ 1] Keyboard → Input Buffer"
}

intent handle_disk_interrupt {
    out "   [IRQ 14] Disk → I/O Complete"
}

intent handle_network_interrupt {
    out "   [IRQ 11] Network → Packet Received"
}

out "   ✅ 4 interrupt handlers registered"
out ""

# === 系统调用接口 ===
out "📞 Setting up Syscall Interface:"

intent syscall_fork {
    out "   [SYS 1] fork() → Create process"
}

intent syscall_exec {
    out "   [SYS 2] exec() → Load program"
}

intent syscall_read {
    out "   [SYS 3] read() → Read file"
}

intent syscall_write {
    out "   [SYS 4] write() → Write file"
}

intent syscall_adaptive_hint {
    out "   [SYS 99] adaptive_hint() → Fate optimization"
}

out "   ✅ 5 syscalls registered (including adaptive)"
out ""

