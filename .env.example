# Valhalla Base — environment template (copy to .env)
# cp .env.example .env

# Build
RUSTFLAGS=-L /opt/cuda/lib64
VALHALLA_GIT_SHA=dev

# Inference
VALHALLA_USE_CPU=0
VALHALLA_LM_MODEL=Qwen/Qwen2.5-3B-Instruct
VALHALLA_LM_F16=0

# HTTP
VALHALLA_BASE_PORT=8787
VALHALLA_SERVE_DASHBOARD=1
VALHALLA_DASHBOARD_PORT=8765

# Benchmark harness
VALHALLA_INFER_URL=http://127.0.0.1:8787/v1/infer
VALHALLA_AUTO_SERVE=1

# Repro shortcuts
# make repro
# python3 tools/valhalla_inference/vb.py suite fate-core
