# Wave GPU 规则测试
# 验证规则组合 → GPU 加速的设计

out "═══════════════════════════════════════════════════════════\n"
out "  Wave GPU Rules Test (CPU Fallback Mode)\n"
out "═══════════════════════════════════════════════════════════\n\n"

# ─────────────────────────────────────────────────────────────
# Test 1: orbital + entropy → 向量加法
# GPU: N threads 并行
# ─────────────────────────────────────────────────────────────

out "[1] Vector Add (orbital + entropy)\n"
out "    GPU: each element = 1 thread\n"

a0 = 10
a1 = 20
a2 = 30
a3 = 40

b0 = 1
b1 = 2
b2 = 3
b3 = 4

# 每个加法独立 → 可并行
c0 = a0 + b0
c1 = a1 + b1
c2 = a2 + b2
c3 = a3 + b3

sum = c0 + c1 + c2 + c3
when sum == 110 { out "    Result: 110 (PASS)\n" }

# ─────────────────────────────────────────────────────────────
# Test 2: gravitational → 规约求和
# GPU: parallel reduction tree
# ─────────────────────────────────────────────────────────────

out "\n[2] Reduce Sum (gravitational)\n"
out "    GPU: parallel reduction O(log N)\n"

d0 = 1
d1 = 2
d2 = 3
d3 = 4
d4 = 5

# 规约: 可用 tree reduction
# Step 1: (1+2), (3+4), (5)
# Step 2: (3+7), (5)
# Step 3: (10+5) = 15
total = d0 + d1 + d2 + d3 + d4
when total == 15 { out "    Result: 15 (PASS)\n" }

# ─────────────────────────────────────────────────────────────
# Test 3: entropy + gravitational → 点积
# GPU: parallel mul + parallel reduce
# ─────────────────────────────────────────────────────────────

out "\n[3] Dot Product (entropy + gravitational)\n"
out "    GPU: parallel mul -> parallel reduce\n"

q0 = 1
q1 = 2
q2 = 3
q3 = 4

v0 = 4
v1 = 3
v2 = 2
v3 = 1

# Step 1: entropy (并行乘法)
p0 = q0 * v0
p1 = q1 * v1
p2 = q2 * v2
p3 = q3 * v3

# Step 2: gravitational (并行规约)
dot = p0 + p1 + p2 + p3

# 1*4 + 2*3 + 3*2 + 4*1 = 4+6+6+4 = 20
when dot == 20 { out "    Result: 20 (PASS)\n" }

# ─────────────────────────────────────────────────────────────
# Test 4: orbital + tension → 向量搜索
# GPU: parallel compare + atomic max
# ─────────────────────────────────────────────────────────────

out "\n[4] Vector Search (orbital + tension)\n"
out "    GPU: parallel scores + atomic argmax\n"

best_i = 0
best_s = 0 - 9999

# 模拟 5 个向量的分数
s0 = 10
s1 = 25
s2 = 15
s3 = 30
s4 = 20

# 找最大 (GPU: 并行比较 + atomic max)
when s0 > best_s { best_s = s0  best_i = 0 }
when s1 > best_s { best_s = s1  best_i = 1 }
when s2 > best_s { best_s = s2  best_i = 2 }
when s3 > best_s { best_s = s3  best_i = 3 }
when s4 > best_s { best_s = s4  best_i = 4 }

when best_i == 3 { out "    Best idx: 3 (PASS)\n" }

# ─────────────────────────────────────────────────────────────
# Test 5: orbital × orbital → 矩阵乘法元素
# GPU: 2D thread blocks
# ─────────────────────────────────────────────────────────────

out "\n[5] Matrix Element (orbital x orbital)\n"
out "    GPU: 2D thread blocks\n"

# 2x2 矩阵乘法的一个元素
# C[0,0] = A[0,0]*B[0,0] + A[0,1]*B[1,0]
a00 = 1
a01 = 2
b00 = 3
b10 = 4

c00 = a00 * b00 + a01 * b10
# 1*3 + 2*4 = 3+8 = 11
when c00 == 11 { out "    C[0,0]: 11 (PASS)\n" }

out "\n═══════════════════════════════════════════════════════════\n"
out "  All GPU Rules Tests Complete!\n"
out "═══════════════════════════════════════════════════════════\n"

out "\n"
out "┌─────────────────────────────────────────────────────────┐\n"
out "│           Rule -> GPU Mapping Verified                 │\n"
out "├─────────────────────────────────────────────────────────┤\n"
out "│  orbital + entropy      -> parallel element ops        │\n"
out "│  gravitational          -> parallel reduction          │\n"
out "│  entropy + gravitational-> dot product                 │\n"
out "│  orbital + tension      -> parallel search             │\n"
out "│  orbital x orbital      -> 2D matrix ops               │\n"
out "└─────────────────────────────────────────────────────────┘\n"

syscall.exit(0)
