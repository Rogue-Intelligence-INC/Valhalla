# 🌊 Wave 完整规则系统 — 静态版 (GPU 加速)
# Rules 搭配组合 → 机器行为 (自动 CPU/GPU 选择)
#
# 设计理念：
#   不是 机器行为 → 对应 Rules
#   而是 Rules 组合 → 产生 机器行为 → 自动选择 CPU/GPU
#
# GPU 映射：
#   orbital  → parallel kernel (thread blocks)
#   entropy  → SIMD ALU (vector lanes)
#   gravitational → memory coalesce (gather/scatter)
#   tension  → sync barrier (atomics)

use rules/unified
use rules/gpu

# ═══════════════════════════════════════════════════════════════════════════
# 八大基础规则 (从统一场 i,e,r 派生)
# ═══════════════════════════════════════════════════════════════════════════

# 1. 引力规则 (Gravitational)
#    - 吸引、聚合、向心
#    - 数据流向、加载、收集
gravitational = derive.gravitational()

# 2. 张力规则 (Tension)
#    - 拉伸、对比、临界
#    - 比较、条件判断、分支选择
tension = derive.tension()

# 3. 熵规则 (Entropy)
#    - 混沌、变换、计算
#    - 算术运算、逻辑运算、位操作
entropy = derive.entropy()

# 4. 连接规则 (Connection)
#    - 桥接、传递、链接
#    - 函数调用、参数传递、返回值
connection = derive.connection()

# 5. 记忆规则 (Memory)
#    - 保持、存储、持久
#    - 写入、缓存、状态保存
memory = derive.memory()

# 6. 轨道规则 (Orbital)
#    - 周期、循环、稳定运动
#    - 循环、迭代、重复执行
orbital = derive.orbital()

# 7. 边界规则 (Boundary)
#    - 隔离、封装、作用域
#    - 栈帧、函数边界、命名空间
boundary = derive.boundary()

# 8. 演化规则 (Evolution)
#    - 变换、适应、转化
#    - 类型转换、系统调用、格式变换
evolution = derive.evolution()

# ═══════════════════════════════════════════════════════════════════════════
# 规则评估 — 计算规则强度
# ═══════════════════════════════════════════════════════════════════════════

fn rule.evaluate name context {
    when name == "gravitational" {
        -> gravitational.strength * context.mass
    }
    when name == "tension" {
        -> tension.base + tension.accumulation * context.delta
    }
    when name == "entropy" {
        -> entropy.initial + entropy.growth * context.complexity
    }
    when name == "connection" {
        -> connection.strength * context.count
    }
    when name == "memory" {
        -> memory.persistence * context.size
    }
    when name == "orbital" {
        -> orbital.stability * context.period
    }
    when name == "boundary" {
        -> boundary.isolation * context.depth
    }
    when name == "evolution" {
        -> evolution.adaptability * context.change
    }
    -> 0.0
}

# ═══════════════════════════════════════════════════════════════════════════
# 规则组合 — 多规则协同产生行为
# ═══════════════════════════════════════════════════════════════════════════

fn rules.combine names weights context {
    total = 0.0
    i = 0
    loop {
        when i >= len(names) { break }
        value = rule.evaluate(names[i], context)
        total = total + weights[i] * value
        i = i + 1
    }
    -> total
}

# ═══════════════════════════════════════════════════════════════════════════
# ⚡ 规则组合 → 机器行为
# ═══════════════════════════════════════════════════════════════════════════
#
# 核心理念：不是"mov 指令对应什么规则"
#           而是"引力+连接 组合后会产生 mov 行为"

# ───────────────────────────────────────────────────────────────────────────
# 数据移动行为 (Data Movement)
# ───────────────────────────────────────────────────────────────────────────

# mov: 引力(吸引目标) + 连接(建立通路)
fn behavior.mov {
    -> rules.combine(
        ["gravitational", "connection"],
        [0.6, 0.4],
        { mass: 1, count: 1 }
    )
}

# load: 引力(从内存吸取) + 记忆(访问存储)
fn behavior.load {
    -> rules.combine(
        ["gravitational", "memory"],
        [0.5, 0.5],
        { mass: 1, size: 1 }
    )
}

# store: 记忆(写入存储) + 引力(定位目标)
fn behavior.store {
    -> rules.combine(
        ["memory", "gravitational"],
        [0.6, 0.4],
        { size: 1, mass: 1 }
    )
}

# push: 记忆(保存) + 边界(栈边界移动)
fn behavior.push {
    -> rules.combine(
        ["memory", "boundary"],
        [0.5, 0.5],
        { size: 1, depth: 1 }
    )
}

# pop: 边界(栈边界收缩) + 引力(取回数据)
fn behavior.pop {
    -> rules.combine(
        ["boundary", "gravitational"],
        [0.5, 0.5],
        { depth: 1, mass: 1 }
    )
}

# ───────────────────────────────────────────────────────────────────────────
# 算术运算行为 (Arithmetic)
# ───────────────────────────────────────────────────────────────────────────

# add: 熵(计算变换) + 引力(聚合两值)
fn behavior.add {
    -> rules.combine(
        ["entropy", "gravitational"],
        [0.6, 0.4],
        { complexity: 1, mass: 2 }
    )
}

# sub: 熵(计算变换) + 张力(差值对比)
fn behavior.sub {
    -> rules.combine(
        ["entropy", "tension"],
        [0.6, 0.4],
        { complexity: 1, delta: 1 }
    )
}

# mul: 熵(复杂计算) + 轨道(重复累加)
fn behavior.mul {
    -> rules.combine(
        ["entropy", "orbital"],
        [0.5, 0.5],
        { complexity: 2, period: 1 }
    )
}

# div: 熵(复杂计算) + 张力(分割)
fn behavior.div {
    -> rules.combine(
        ["entropy", "tension"],
        [0.5, 0.5],
        { complexity: 2, delta: 1 }
    )
}

# mod: 熵(计算) + 轨道(周期余数)
fn behavior.mod {
    -> rules.combine(
        ["entropy", "orbital"],
        [0.4, 0.6],
        { complexity: 1, period: 1 }
    )
}

# neg: 熵(变换) + 张力(极性反转)
fn behavior.neg {
    -> rules.combine(
        ["entropy", "tension"],
        [0.5, 0.5],
        { complexity: 1, delta: 1 }
    )
}

# ───────────────────────────────────────────────────────────────────────────
# 逻辑运算行为 (Logic)
# ───────────────────────────────────────────────────────────────────────────

# and: 熵(位操作) + 引力(同时满足)
fn behavior.and {
    -> rules.combine(
        ["entropy", "gravitational"],
        [0.5, 0.5],
        { complexity: 1, mass: 2 }
    )
}

# or: 熵(位操作) + 连接(任一满足)
fn behavior.or {
    -> rules.combine(
        ["entropy", "connection"],
        [0.5, 0.5],
        { complexity: 1, count: 2 }
    )
}

# xor: 熵(位操作) + 张力(排他)
fn behavior.xor {
    -> rules.combine(
        ["entropy", "tension"],
        [0.5, 0.5],
        { complexity: 1, delta: 1 }
    )
}

# not: 熵(位操作) + 演化(反转)
fn behavior.not {
    -> rules.combine(
        ["entropy", "evolution"],
        [0.5, 0.5],
        { complexity: 1, change: 1 }
    )
}

# shl: 熵(位移) + 引力(向左聚集)
fn behavior.shl {
    -> rules.combine(
        ["entropy", "gravitational"],
        [0.6, 0.4],
        { complexity: 1, mass: 1 }
    )
}

# shr: 熵(位移) + 边界(向右扩散)
fn behavior.shr {
    -> rules.combine(
        ["entropy", "boundary"],
        [0.6, 0.4],
        { complexity: 1, depth: 1 }
    )
}

# ───────────────────────────────────────────────────────────────────────────
# 比较行为 (Comparison)
# ───────────────────────────────────────────────────────────────────────────

# cmp: 张力(对比差异)
fn behavior.cmp {
    -> rules.combine(
        ["tension"],
        [1.0],
        { delta: 1 }
    )
}

# test: 张力(对比) + 熵(位测试)
fn behavior.test {
    -> rules.combine(
        ["tension", "entropy"],
        [0.6, 0.4],
        { delta: 1, complexity: 1 }
    )
}

# ───────────────────────────────────────────────────────────────────────────
# 控制流行为 (Control Flow)
# ───────────────────────────────────────────────────────────────────────────

# jmp: 轨道(跳转到新位置)
fn behavior.jmp {
    -> rules.combine(
        ["orbital"],
        [1.0],
        { period: 0 }  # period=0 表示非周期，单次跳转
    )
}

# jz: 张力(条件检查) + 轨道(条件跳转)
fn behavior.jz {
    -> rules.combine(
        ["tension", "orbital"],
        [0.6, 0.4],
        { delta: 1, period: 0 }
    )
}

# jnz: 张力(条件检查) + 轨道(条件跳转)
fn behavior.jnz {
    -> rules.combine(
        ["tension", "orbital"],
        [0.6, 0.4],
        { delta: 1, period: 0 }
    )
}

# jl/jg/jle/jge: 张力(比较) + 轨道(跳转)
fn behavior.jcc {
    -> rules.combine(
        ["tension", "orbital"],
        [0.7, 0.3],
        { delta: 1, period: 0 }
    )
}

# call: 连接(建立调用链) + 边界(新栈帧)
fn behavior.call {
    -> rules.combine(
        ["connection", "boundary"],
        [0.5, 0.5],
        { count: 1, depth: 1 }
    )
}

# ret: 边界(离开栈帧) + 连接(返回调用者)
fn behavior.ret {
    -> rules.combine(
        ["boundary", "connection"],
        [0.5, 0.5],
        { depth: -1, count: 1 }
    )
}

# loop: 轨道(周期) + 张力(退出条件)
fn behavior.loop {
    -> rules.combine(
        ["orbital", "tension"],
        [0.7, 0.3],
        { period: 1, delta: 1 }
    )
}

# ───────────────────────────────────────────────────────────────────────────
# 系统行为 (System)
# ───────────────────────────────────────────────────────────────────────────

# syscall: 演化(跨越用户/内核边界) + 连接(系统接口)
fn behavior.syscall {
    -> rules.combine(
        ["evolution", "connection"],
        [0.6, 0.4],
        { change: 1, count: 1 }
    )
}

# nop: 轨道(最小周期，空转)
fn behavior.nop {
    -> rules.combine(
        ["orbital"],
        [1.0],
        { period: 0.001 }
    )
}

# pause: 轨道(暂停) + 记忆(保持状态)
fn behavior.pause {
    -> rules.combine(
        ["orbital", "memory"],
        [0.5, 0.5],
        { period: 1, size: 0 }
    )
}

# halt: 边界(终止) + 轨道(停止)
fn behavior.halt {
    -> rules.combine(
        ["boundary", "orbital"],
        [0.7, 0.3],
        { depth: 0, period: 0 }
    )
}

# ───────────────────────────────────────────────────────────────────────────
# 内存管理行为 (Memory Management)
# ───────────────────────────────────────────────────────────────────────────

# alloc: 边界(划分空间) + 记忆(分配)
fn behavior.alloc {
    -> rules.combine(
        ["boundary", "memory"],
        [0.5, 0.5],
        { depth: 1, size: 1 }
    )
}

# free: 边界(释放空间) + 熵(回收混沌)
fn behavior.free {
    -> rules.combine(
        ["boundary", "entropy"],
        [0.5, 0.5],
        { depth: -1, complexity: 1 }
    )
}

# mmap: 演化(地址映射) + 边界(区域划分)
fn behavior.mmap {
    -> rules.combine(
        ["evolution", "boundary"],
        [0.5, 0.5],
        { change: 1, depth: 1 }
    )
}

# ───────────────────────────────────────────────────────────────────────────
# I/O 行为 (Input/Output)
# ───────────────────────────────────────────────────────────────────────────

# read: 引力(吸取数据) + 连接(外部接口)
fn behavior.read {
    -> rules.combine(
        ["gravitational", "connection"],
        [0.5, 0.5],
        { mass: 1, count: 1 }
    )
}

# write: 张力(释放数据) + 连接(外部接口)
fn behavior.write {
    -> rules.combine(
        ["tension", "connection"],
        [0.5, 0.5],
        { delta: 1, count: 1 }
    )
}

# ═══════════════════════════════════════════════════════════════════════════
# 行为到机器码映射
# ═══════════════════════════════════════════════════════════════════════════

fn behavior.emit name args {
    intensity = 0
    
    # 计算规则组合强度
    when name == "mov" { intensity = behavior.mov() }
    when name == "add" { intensity = behavior.add() }
    when name == "sub" { intensity = behavior.sub() }
    when name == "mul" { intensity = behavior.mul() }
    when name == "div" { intensity = behavior.div() }
    when name == "and" { intensity = behavior.and() }
    when name == "or" { intensity = behavior.or() }
    when name == "xor" { intensity = behavior.xor() }
    when name == "cmp" { intensity = behavior.cmp() }
    when name == "jmp" { intensity = behavior.jmp() }
    when name == "jz" { intensity = behavior.jz() }
    when name == "jnz" { intensity = behavior.jnz() }
    when name == "call" { intensity = behavior.call() }
    when name == "ret" { intensity = behavior.ret() }
    when name == "push" { intensity = behavior.push() }
    when name == "pop" { intensity = behavior.pop() }
    when name == "syscall" { intensity = behavior.syscall() }
    when name == "nop" { intensity = behavior.nop() }
    
    # 根据强度选择最优机器码
    -> gen.emit_optimal(name, args, intensity)
}

# ═══════════════════════════════════════════════════════════════════════════
# 报告
# ═══════════════════════════════════════════════════════════════════════════

fn rules.report {
    out "[Rules] 八大基础规则:\n"
    out "  gravitational: " out gravitational.strength out "\n"
    out "  tension: " out tension.base out "\n"
    out "  entropy: " out entropy.initial out "\n"
    out "  connection: " out connection.strength out "\n"
    out "  memory: " out memory.persistence out "\n"
    out "  orbital: " out orbital.stability out "\n"
    out "  boundary: " out boundary.isolation out "\n"
    out "  evolution: " out evolution.adaptability out "\n"
}

# ═══════════════════════════════════════════════════════════════════════════
# ⚡ GPU 加速规则组合
# ═══════════════════════════════════════════════════════════════════════════
#
# 当规则组合符合 GPU 并行模式时，自动选择 GPU 执行
# 阈值由 unified 参数控制

# GPU 加速阈值
gpu_threshold = 64  # 数据量超过此值使用 GPU

# ───────────────────────────────────────────────────────────────────────────
# 向量运算 (orbital × entropy)
# GPU: 每个元素一个 thread，无依赖
# ───────────────────────────────────────────────────────────────────────────

# 向量加法
fn vector.add a b result size {
    # 规则组合: orbital (循环) + entropy (计算)
    # 并行度: 完美并行，无依赖
    when size >= gpu_threshold {
        when gpu.enabled {
            gpu.vector_op("add", a, b, result, size)
            return
        }
    }
    
    # CPU 回退
    i = 0
    loop {
        when i >= size { break }
        result[i] = a[i] + b[i]
        i = i + 1
    }
}

# 向量乘法 (element-wise)
fn vector.mul a b result size {
    when size >= gpu_threshold {
        when gpu.enabled {
            gpu.vector_op("mul", a, b, result, size)
            return
        }
    }
    
    i = 0
    loop {
        when i >= size { break }
        result[i] = a[i] * b[i]
        i = i + 1
    }
}

# 向量减法
fn vector.sub a b result size {
    when size >= gpu_threshold {
        when gpu.enabled {
            gpu.vector_op("sub", a, b, result, size)
            return
        }
    }
    
    i = 0
    loop {
        when i >= size { break }
        result[i] = a[i] - b[i]
        i = i + 1
    }
}

# ───────────────────────────────────────────────────────────────────────────
# 规约运算 (gravitational)
# GPU: parallel reduction tree, O(log N)
# ───────────────────────────────────────────────────────────────────────────

# 求和
fn vector.sum data size {
    when size >= gpu_threshold {
        when gpu.enabled {
            -> gpu.reduce("sum", data, size)
        }
    }
    
    result = 0
    i = 0
    loop {
        when i >= size { break }
        result = result + data[i]
        i = i + 1
    }
    -> result
}

# 最大值
fn vector.max data size {
    when size >= gpu_threshold {
        when gpu.enabled {
            -> gpu.reduce("max", data, size)
        }
    }
    
    result = data[0]
    i = 1
    loop {
        when i >= size { break }
        when data[i] > result { result = data[i] }
        i = i + 1
    }
    -> result
}

# 最小值
fn vector.min data size {
    when size >= gpu_threshold {
        when gpu.enabled {
            -> gpu.reduce("min", data, size)
        }
    }
    
    result = data[0]
    i = 1
    loop {
        when i >= size { break }
        when data[i] < result { result = data[i] }
        i = i + 1
    }
    -> result
}

# ───────────────────────────────────────────────────────────────────────────
# 点积 (entropy × gravitational)
# GPU: 并行乘法 + 并行规约
# ───────────────────────────────────────────────────────────────────────────

fn vector.dot a b size {
    when size >= gpu_threshold {
        when gpu.enabled {
            -> gpu.dot(a, b, size)
        }
    }
    
    sum = 0
    i = 0
    loop {
        when i >= size { break }
        sum = sum + a[i] * b[i]
        i = i + 1
    }
    -> sum
}

# ───────────────────────────────────────────────────────────────────────────
# 向量搜索 (orbital × gravitational × tension)
# GPU: 并行点积 + 并行 max reduction
# ───────────────────────────────────────────────────────────────────────────

fn vector.search query vectors count dim {
    when count >= gpu_threshold {
        when gpu.enabled {
            -> gpu.vector_search(query, vectors, count, dim)
        }
    }
    
    best_idx = 0
    best_score = 0 - 999999999
    i = 0
    loop {
        when i >= count { break }
        score = vector.dot(query, vectors + i * dim, dim)
        when score > best_score {
            best_score = score
            best_idx = i
        }
        i = i + 1
    }
    -> best_idx
}

# ───────────────────────────────────────────────────────────────────────────
# 矩阵乘法 (orbital × orbital × entropy)
# GPU: 2D thread blocks, tiled multiplication
# ───────────────────────────────────────────────────────────────────────────

fn matrix.mul A B C m n k {
    total = m * n
    when total >= gpu_threshold {
        when gpu.enabled {
            gpu.matmul(A, B, C, m, n, k)
            return
        }
    }
    
    # CPU 回退
    i = 0
    loop {
        when i >= m { break }
        j = 0
        loop {
            when j >= n { break }
            sum = 0
            l = 0
            loop {
                when l >= k { break }
                sum = sum + A[i*k + l] * B[l*n + j]
                l = l + 1
            }
            C[i*n + j] = sum
            j = j + 1
        }
        i = i + 1
    }
}

# ───────────────────────────────────────────────────────────────────────────
# 并行排序 (orbital × tension)
# GPU: Bitonic sort
# ───────────────────────────────────────────────────────────────────────────

fn vector.sort data size {
    when size >= gpu_threshold {
        when gpu.enabled {
            gpu.sort(data, size)
            return
        }
    }
    
    # CPU 回退: 简单冒泡排序
    i = 0
    loop {
        when i >= size { break }
        j = i + 1
        loop {
            when j >= size { break }
            when data[j] < data[i] {
                temp = data[i]
                data[i] = data[j]
                data[j] = temp
            }
            j = j + 1
        }
        i = i + 1
    }
}

# ═══════════════════════════════════════════════════════════════════════════
# GPU 加速状态报告
# ═══════════════════════════════════════════════════════════════════════════

fn rules.gpu_report {
    out "[Rules-GPU] 加速状态:\n"
    out "  gpu_threshold: "
    out gpu_threshold
    out "\n"
    gpu.report()
}
