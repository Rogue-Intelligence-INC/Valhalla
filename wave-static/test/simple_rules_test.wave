# Wave-Static 简单规则测试

out "═════════════════════════════════════════════════════\n"
out "  Wave-Static Rules System Test\n"
out "═════════════════════════════════════════════════════\n"
out "\n"

# Test 1: 数据移动 (gravitational + connection → mov)
out "[1] Data Movement: "
a = 42
b = a
when b == 42 { out "PASS\n" }

# Test 2: 算术运算 (entropy + gravitational → add)
out "[2] Arithmetic Add: "
x = 10
y = 3
z = x + y
when z == 13 { out "PASS\n" }

# Test 3: 算术运算 (entropy + tension → sub)
out "[3] Arithmetic Sub: "
d = x - y
when d == 7 { out "PASS\n" }

# Test 4: 算术运算 (entropy + orbital → mul)
out "[4] Arithmetic Mul: "
m = x * y
when m == 30 { out "PASS\n" }

# Test 5: 比较 (tension → cmp)
out "[5] Comparison: "
when x > y { out "PASS\n" }

# Test 6: 循环 (orbital + tension → loop)
out "[6] Loop: "
i = 0
count = 0
loop {
    when i >= 5 { break }
    count = count + 1
    i = i + 1
}
when count == 5 { out "PASS\n" }

# Test 7: 函数 (connection + boundary → call/ret)
out "[7] Function: "
fn add_ten n {
    -> n + 10
}
result = add_ten(5)
when result == 15 { out "PASS\n" }

# Test 8: 嵌套条件 (tension + orbital)
out "[8] Nested: "
sum = 0
i = 1
loop {
    when i > 5 { break }
    when i == 1 { sum = sum + 1 }
    when i == 3 { sum = sum + 3 }
    when i == 5 { sum = sum + 5 }
    i = i + 1
}
when sum == 9 { out "PASS\n" }

out "\n"
out "═════════════════════════════════════════════════════\n"
out "  All 8 Tests Complete!\n"
out "═════════════════════════════════════════════════════\n"

syscall.exit(0)
