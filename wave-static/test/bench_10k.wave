# Wave 10K 向量搜索

out "Wave: 10000 vectors, DIM=4\n"

q0 = 10
q1 = 20
q2 = 30
q3 = 40

best_idx = 0
best_score = 0 - 99999999
seed = 42

i = 0
loop {
    when i >= 10000 { break }
    
    seed = seed * 1103 + 13
    t = seed / 10000
    seed = seed - t * 10000
    v0 = seed / 100 - 50
    
    seed = seed * 1103 + 13
    t = seed / 10000
    seed = seed - t * 10000
    v1 = seed / 100 - 50
    
    seed = seed * 1103 + 13
    t = seed / 10000
    seed = seed - t * 10000
    v2 = seed / 100 - 50
    
    seed = seed * 1103 + 13
    t = seed / 10000
    seed = seed - t * 10000
    v3 = seed / 100 - 50
    
    score = q0 * v0 + q1 * v1 + q2 * v2 + q3 * v3
    
    when score > best_score {
        best_score = score
        best_idx = i
    }
    
    i = i + 1
}

out "Done!\n"
syscall.exit(0)
